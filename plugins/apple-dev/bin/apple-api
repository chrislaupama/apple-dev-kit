#!/usr/bin/python3 -I
"""apple-api — look up Apple APIs in the installed SDK's Swift interfaces.

Answers "does this API exist in the user's SDK, and since which OS?" from the
.swiftinterface files Xcode ships, offline and exactly matching the SDK.

usage: apple-api <Framework> <regex>          declarations matching regex
       apple-api <Framework> --new <version>  declarations introduced in that OS version
       apple-api --frameworks                 frameworks with Swift interfaces
options: --platform iOS|macOS|watchOS|tvOS|visionOS (default iOS)
         --limit N (default 60)   --context (show enclosing type for each match)
examples: apple-api SwiftUI 'func glassEffect'
          apple-api SwiftUI --new 27 --limit 200
          apple-api FoundationModels 'class LanguageModelSession' --context
"""
import argparse
import re
import subprocess
import sys
from pathlib import Path

SDKS = {"iOS": "iphoneos", "macOS": "macosx", "watchOS": "watchos", "tvOS": "appletvos", "visionOS": "xros"}
DECL = re.compile(
    r"^\s*(?:@[\w.()\" ,:*]+\s+)*(?:(?:public|open|nonisolated|final|static|class|override|mutating|convenience|required|indirect|dynamic|optional|@preconcurrency|@MainActor|@_Concurrency\.MainActor)\s+)*"
    r"(func|var|let|struct|class|enum|protocol|case|init|subscript|typealias|associatedtype|extension|actor|macro)\b"
)


def sdk_path(platform):
    return Path(subprocess.check_output(["xcrun", "--sdk", SDKS[platform], "--show-sdk-path"], text=True).strip())


def module_interface(sdk, module):
    for c in (sdk / f"System/Library/Frameworks/{module}.framework/Modules/{module}.swiftmodule",
              sdk / f"usr/lib/swift/{module}.swiftmodule"):
        files = [f for f in c.glob("*.swiftinterface") if not f.name.endswith(".private.swiftinterface")] if c.is_dir() else []
        # One architecture is enough; prefer arm64e, then arm64.
        files.sort(key=lambda f: (0 if f.name.startswith("arm64e") else 1 if f.name.startswith("arm64") else 2))
        if files:
            return files[0]
    return None


def interface_files(sdk, framework):
    """The framework's interface plus its Core module and cross-import overlays (SwiftUI → SwiftUICore, _MapKit_SwiftUI…)."""
    modules = [framework, f"{framework}Core"]
    modules += sorted(p.name.split(".")[0] for p in (sdk / "System/Library/Frameworks").glob(f"_*_{framework}.framework"))
    return [f for f in (module_interface(sdk, m) for m in modules) if f]


def list_frameworks(sdk):
    names = {p.name.split(".")[0] for p in (sdk / "System/Library/Frameworks").glob("*.framework/Modules/*.swiftmodule")}
    names |= {p.name.split(".")[0] for p in (sdk / "usr/lib/swift").glob("*.swiftmodule")}
    print("\n".join(sorted(n for n in names if not n.startswith("_"))))


def scan(path, matcher, show_context, limit):
    shown = 0
    attrs = []
    context = ""
    for raw in path.read_text(errors="replace").splitlines():
        line = raw.rstrip()
        stripped = line.strip()
        if not stripped or stripped.startswith(("#if", "#else", "#endif", "//")):
            continue
        if stripped.startswith("@") and not DECL.match(line):
            attrs.append(stripped)
            continue
        if DECL.match(line):
            if not line.startswith((" ", "\t")):
                context = stripped.split("{")[0].strip()
            block = attrs + [stripped.split("{")[0].rstrip()]
            if matcher(block):
                if show_context and line.startswith((" ", "\t")) and context:
                    print(f"// in: {context}")
                print("\n".join(block))
                print()
                shown += 1
                if shown >= limit:
                    print(f"… stopped at --limit {limit}")
                    return shown
        attrs = []
    return shown


def main():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("framework", nargs="?")
    parser.add_argument("pattern", nargs="?")
    parser.add_argument("--platform", default="iOS", choices=SDKS)
    parser.add_argument("--new")
    parser.add_argument("--limit", type=int, default=60)
    parser.add_argument("--context", action="store_true")
    parser.add_argument("--frameworks", action="store_true")
    parser.add_argument("-h", "--help", action="store_true")
    args = parser.parse_args()

    if args.help or (not args.frameworks and not args.framework):
        print(__doc__.strip())
        return 0
    sdk = sdk_path(args.platform)
    if args.frameworks:
        list_frameworks(sdk)
        return 0
    files = interface_files(sdk, args.framework)
    if not files:
        print(f"apple-api: no Swift interface for {args.framework} in {sdk.name} (see: apple-api --frameworks)", file=sys.stderr)
        return 1
    if args.new:
        platform_key = {"visionOS": "visionOS", "macOS": "macOS"}.get(args.platform, args.platform)
        needle = re.compile(rf"\b{platform_key} {re.escape(args.new)}(\.0)?\b")
        matcher = lambda block: any(b.startswith("@available") and needle.search(b) for b in block)
    elif args.pattern:
        rx = re.compile(args.pattern)
        matcher = lambda block: bool(rx.search(block[-1]))
    else:
        print("apple-api: give a regex or --new <version>", file=sys.stderr)
        return 64
    found = 0
    for f in files:
        remaining = args.limit - found
        if remaining <= 0:
            break
        module = f.parent.name.split(".")[0]
        print(f"// {module} — {sdk.name}\n")
        found += scan(f, matcher, args.context, remaining)
    if not found:
        print("No matches. The API may not exist in this SDK, may live in another framework, or may be Objective-C only (check the framework's Headers/).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
